            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='8'>Prop statins prescriptions as % of list size</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cholesterol (Cholesterol combined dataset)' name='federated.1jbectg0lny8jj0zunw5j0ly7v3x' />
